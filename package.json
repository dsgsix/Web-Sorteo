{
  "name": "sortea",
  "version": "1.0.0",
  "private": true,
  "description": "Sorteos claros, rápidos y locales en tu navegador.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --host 0.0.0.0 --port 5173",
